    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Что заставило тебя смеяться недавно?",
      "id": "td_ru_105"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Какой школьный предмет тебе нравился?",
      "id": "td_ru_106"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Какое твое любимое животное и почему?",
      "id": "td_ru_107"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Как ты любишь расслабляться перед сном?",
      "id": "td_ru_108"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Сделай 10 прыжков звездочка.",
      "id": "td_ru_109"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Шепчи следующие 30 секунд.",
      "id": "td_ru_110"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Удерживай равновесие 10 секунд, как будто на голове книга.",
      "id": "td_ru_111"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Сделай смешную гримасу и держи 15 секунд.",
      "id": "td_ru_112"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Станцуй робота 10 секунд.",
      "id": "td_ru_113"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Нарисуй в воздухе маленький рисунок.",
      "id": "td_ru_114"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Изобрази кота 10 секунд.",
      "id": "td_ru_115"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Скажи искренний комплимент кому-то в комнате.",
      "id": "td_ru_116"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Скажи алфавит задом наперед, сколько сможешь.",
      "id": "td_ru_117"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Сыграй ведущего новостей 20 секунд.",
      "id": "td_ru_118"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Покрутись 3 раза и пройди прямо.",
      "id": "td_ru_119"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Простучи короткий ритм по столу.",
      "id": "td_ru_120"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Быстро потянись и дотронься до пальцев ног.",
      "id": "td_ru_121"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Скажи одно предложение как в трейлере фильма.",
      "id": "td_ru_122"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Прими позу супергероя на 10 секунд.",
      "id": "td_ru_123"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Пройдись 10 секунд в замедленной съемке.",
      "id": "td_ru_124"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Напой мелодию, чтобы другие угадали.",
      "id": "td_ru_125"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Издай звук лающей собаки.",
      "id": "td_ru_126"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Скажи скороговорку три раза быстро.",
      "id": "td_ru_127"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Сделай мини-танец победы.",
      "id": "td_ru_128"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Хлопни ритм, пусть другие повторят.",
      "id": "td_ru_129"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Изобрази робота и назови свое имя.",
      "id": "td_ru_130"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Сделай сердечко руками.",
      "id": "td_ru_131"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "В тишине изобрази, как делаешь бутерброд.",
      "id": "td_ru_132"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Нарисуй смайлик в воздухе.",
      "id": "td_ru_133"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Сделай 5 приседаний.",
      "id": "td_ru_134"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Скажи спасибо на трех языках.",
      "id": "td_ru_135"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Постой в планке 5 секунд.",
      "id": "td_ru_136"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Изобрази скрип двери.",
      "id": "td_ru_137"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Покажи маленький фокус или сделай вид.",
      "id": "td_ru_138"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Издай звук животного, которое выберет группа.",
      "id": "td_ru_139"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Походи как пингвин 10 секунд.",
      "id": "td_ru_140"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Сделай вид, что снимаешь драматичное селфи.",
      "id": "td_ru_141"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Придумай одно предложение про сегодня в форме стиха.",
      "id": "td_ru_142"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Скажи свое имя смешным голосом.",
      "id": "td_ru_143"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Сыграй ведущего кулинарного шоу 15 секунд.",
      "id": "td_ru_144"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Нарисуй вокруг себя воображаемый круг.",
      "id": "td_ru_145"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Дай всем пять или в воздухе.",
      "id": "td_ru_146"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Изобрази, что ты в замедленной съемке, 10 секунд.",
      "id": "td_ru_147"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Сделай короткий танец плечами.",
      "id": "td_ru_148"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Издай звук звонящего телефона.",
      "id": "td_ru_149"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Коротко похлопай и поклонись.",
      "id": "td_ru_150"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Какая мелочь сразу поднимает тебе настроение?",
      "id": "td_ru_151"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Если бы на день у тебя был животный напарник, кто бы это был?",
      "id": "td_ru_152"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Что ты любишь делать в дождливый день?",
      "id": "td_ru_153"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Какую привычку ты сейчас пытаешься улучшить?",
      "id": "td_ru_154"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Что ты искал(а) в телефоне в последний раз?",
      "id": "td_ru_155"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Какой талант тебе хотелось бы иметь?",
      "id": "td_ru_156"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "На кого из этой компании ты больше всего похож(а)?",
      "id": "td_ru_157"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Какой у тебя главный «стоп» в знакомствах?",
      "id": "td_ru_158"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Был ли у тебя когда-нибудь отправленный и сразу же жалеемый текст? О чём он был?",
      "id": "td_ru_159"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Что самое смелое ты делал(а), чтобы впечатлить кого-то?",
      "id": "td_ru_160"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Сделай свой лучший звук животного — пусть группа угадает.",
      "id": "td_ru_161"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Подержи книгу на голове 10 секунд.",
      "id": "td_ru_162"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Нарисуй быстрый набросок домика с глазами.",
      "id": "td_ru_163"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Напиши кому-то \"угадай что?\" и 2 минуты не объясняй.",
      "id": "td_ru_164"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Говори как диктор в кино в следующем раунде.",
      "id": "td_ru_165"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Поменяйся местами с кем-то, не говоря ни слова.",
      "id": "td_ru_166"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Покажи последнее селфи, которое ты сделал(а).",
      "id": "td_ru_167"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Поставь эмодзи в статус на час.",
      "id": "td_ru_168"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Отправь голосовое доверенному человеку: \"У меня есть секрет\".",
      "id": "td_ru_169"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Станцуй 20 секунд, используя только руки.",
      "id": "td_ru_170"
    }
  ]
}
