      "id": "td_fi_105",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna kaikkien nähdä viimeksi poistettu tekstisi."
    },
    {
      "id": "td_fi_106",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Lähetä 'Hei, ajattelen sinua!' uusimmalle exällesi."
    },
    {
      "id": "td_fi_107",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Tee houkuttelevin kävelysi huoneen poikki, kun kaikki katsovat."
    },
    {
      "id": "td_fi_108",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna ryhmän luoda treffiprofiilisi bio."
    },
    {
      "id": "td_fi_109",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Vietä 60 sekuntia yrittääksesi saada joku huoneessa olevasta lähtemään treffeille kanssasi."
    },
    {
      "id": "td_fi_110",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna jonkun esittää sinulle 5 henkilökohtaista kysymystä, joihin sinun on vastattava rehellisesti."
    },
    {
      "id": "td_fi_111",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Serenaadi valitsemallesi henkilölle millä tahansa kappaleella 30 sekunnin ajan."
    },
    {
      "id": "td_fi_112",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna ryhmän järjestää sinut sokkotreffeille valitsemalla yhteystietosi."
    },
    {
      "id": "td_fi_113",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Kerro ryhmälle 3-pisteen tarkistuslistasi mahdolliselle kumppanille."
    },
    {
      "id": "td_fi_114",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna ryhmän muotoilla itsellesi sopiva asu omasta vaatekaapistasi."
    },
    {
      "id": "td_fi_115",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Jaa kuvakaappaus kiusallisimmasta flirttailukeskustelustasi."
    },
    {
      "id": "td_fi_116",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Silmäile jokaiselle puhuvalle henkilölle seuraavan 5 minuutin ajan."
    },
    {
      "id": "td_fi_117",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna jonkun paistaa sinua 60 sekuntia reagoimatta."
    },
    {
      "id": "td_fi_118",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Kerro itsestäsi salaisuus, jota kukaan huoneessa oleva ei tiedä."
    },
    {
      "id": "td_fi_119",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Esitä paras noutolinjasi ja toimita se vieressäsi olevalle henkilölle."
    },
    {
      "id": "td_fi_120",
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna ryhmän luokitella kaikki houkuttelevuuden mukaan ja lukea lista ääneen."
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mitä etsit viimeksi verkosta?",
      "id": "td_fi_121"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Minkä kappaleen kaikki sanat tiedät?",
      "id": "td_fi_122"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mikä on eniten käyttämäsi sovelluksesi?",
      "id": "td_fi_123"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mitä ruokaa voisit syödä joka päivä?",
      "id": "td_fi_124"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mikä on paras kohteliaisuus, jonka olet saanut?",
      "id": "td_fi_125"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mikä on sinun suosikkielokuvasi tai -ohjelmasi?",
      "id": "td_fi_126"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mistä olet ylpeä tänä vuonna?",
      "id": "td_fi_127"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mikä on oudoin tapasi?",
      "id": "td_fi_128"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mikä on lempi tapasi rentoutua?",
      "id": "td_fi_129"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "Mikä on lahja, jonka toivoisit?",
      "id": "td_fi_130"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Tee paras vaikutelmasi julkkiksesta 10 sekunnin ajan.",
      "id": "td_fi_131"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Puhu kuiskaten seuraavaa kierrosta varten.",
      "id": "td_fi_132"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Näytä viimeksi puhelimella ottamasi valokuva.",
      "id": "td_fi_133"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Tee 10 hyppäämistä.",
      "id": "td_fi_134"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Anna jonkun muun valita profiilikuvasi 24 tunnin ajan.",
      "id": "td_fi_135"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Jaa hauska fakta itsestäsi.",
      "id": "td_fi_136"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Pyöritä noin 5 kertaa ja kävele suorassa linjassa.",
      "id": "td_fi_137"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Lähetä ystävällinen emoji viimeksi sinulle tekstiviestin lähettäneelle henkilölle.",
      "id": "td_fi_138"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Teeskentele olevasi uutistoimittaja 20 sekuntia.",
      "id": "td_fi_139"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "Anna ryhmän valita sana, jota sinun tulee käyttää jokaisessa lauseessa 3 minuutin ajan.",
      "id": "td_fi_140"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mikä on hankalin lähettämäsi teksti?",
      "id": "td_fi_141"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Kenelle kirjoitat tällä hetkellä eniten?",
      "id": "td_fi_142"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mikä on lupaus, jota kadut?",
      "id": "td_fi_143"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mistä teeskentelet, että pidät, mutta et pidä?",
      "id": "td_fi_144"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Milloin olit viimeksi kateellinen?",
      "id": "td_fi_145"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Minkä salaisuuden olet salannut ystäviltäsi?",
      "id": "td_fi_146"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mikä on pahin neuvo, jota olet koskaan noudattanut?",
      "id": "td_fi_147"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mikä on kallein asia jonka olet rikkonut?",
      "id": "td_fi_148"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mikä on pelko, jota et ole kertonut kenellekään?",
      "id": "td_fi_149"
    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Kuka on viimeinen henkilö, jonka mykisit tai lopetit seuraamisen?",
      "id": "td_fi_150"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Lähetä tarinaasi satunnainen laulun sana.",
      "id": "td_fi_151"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Lähetä tekstiviesti jollekulle kohteliaisuus heti.",
      "id": "td_fi_152"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Syö välipala ilman käsiäsi.",
      "id": "td_fi_153"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Anna jonkun muotoilla hiuksesi.",
      "id": "td_fi_154"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Lue dramaattisesti viimeksi lähettämäsi viesti.",
      "id": "td_fi_155"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Yritä typerää tanssia 20 sekuntia.",
      "id": "td_fi_156"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Puhu minuutin ajan ryhmän valitsemalla aksentilla.",
      "id": "td_fi_157"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Piirrä nopea muotokuva jostain ryhmään kuuluvasta.",
      "id": "td_fi_158"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Jaa näyttösi 10 sekuntia.",
      "id": "td_fi_159"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Vaihda paikkaa jonkun kanssa seuraavaan vuoroosi asti.",
      "id": "td_fi_160"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Oletko koskaan pitänyt kahdesta ihmisestä samaan aikaan?",
      "id": "td_fi_161"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Mikä on suurin treffin punainen lippusi?",
      "id": "td_fi_162"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Mikä on flirttailevin asia, jonka olet tehnyt viime aikoina?",
      "id": "td_fi_163"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Mitä olet salannut kumppaniltasi?",
      "id": "td_fi_164"
    },
    {
      "type": "truth",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Mikä on rohkein viesti, jonka olet lähettänyt?",
      "id": "td_fi_165"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Näytä viimeisin tallennettu valokuvasi kameran rullalle.",
      "id": "td_fi_166"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Lue viimeisin saamasi DM ääneen.",
      "id": "td_fi_167"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Lähetä flirttaileva GIF jollekulle, johon luotat.",
      "id": "td_fi_168"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Anna ryhmän tarkastella eniten käytettyjä emojiluetteloasi.",
      "id": "td_fi_169"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Tunnusta uusin ihastuksesi (ei nimiä, vain nimikirjaimet).",
      "id": "td_fi_170"
    },
    {
      "id": "td_fi_171",
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mikä on noloin asia hakuhistoriassasi?"
    },
    {
      "id": "td_fi_172",
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Mikä sovellus varastaa suurimman osan ajasta?"
    },
    {
      "id": "td_fi_173",
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "Minkä viestin kirjoitit etkä koskaan lähettänyt?"
    },
    {
      "id": "td_fi_174",
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Näytä ryhmälle viimeisin tallennettu meemi."
    },
    {
      "id": "td_fi_175",
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "Kuvaile viimeistä selfietäsi ikään kuin se olisi museoesine."
    }
  ]
}
