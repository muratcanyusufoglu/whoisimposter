    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "تحدث همسا لمدة 30 ثانية.",
      "id": "td_ar_110"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "حافظ على توازنك 10 ثوان كأن على راسك كتابا.",
      "id": "td_ar_111"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "اعمل تعبير وجه مضحك واثبت 15 ثانية.",
