    },
    {
      "type": "truth",
      "intensity": "medium",
      "minAge": 13,
      "text": "صفق مرة وانحن قليلا.",
      "id": "td_ar_150"
    },
    {
      "type": "dare",
      "intensity": "medium",
      "minAge": 13,
      "text": "ما الشيء الصغير الذي يجعلك تبتسم فوراً؟",
