    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ضع إيموجي كحالة لمدة ساعة.",
      "id": "td_ar_167"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "أرسل رسالة صوتية لشخص تثق به: \"عندي سر\".",
      "id": "td_ar_168"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ارقص 20 ثانية باستخدام ذراعيك فقط.",
      "id": "td_ar_169"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما الرائحة التي تعيد لك ذكراً بسرعة؟",
      "id": "td_ar_170"
    }
