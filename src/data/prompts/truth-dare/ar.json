    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "امش ببطء شديد لمدة 10 ثوان.",
      "id": "td_ar_124"
    },
    {
      "type": "truth",
      "intensity": "mild",
      "minAge": 4,
      "text": "همهم لحنا ودع الاخرين يخمنون.",
