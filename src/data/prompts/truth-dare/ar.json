    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما لعبة الطاولة او الورق المفضلة لديك؟",
      "id": "td_ar_101"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما افضل جزء في روتينك اليومي؟",
      "id": "td_ar_102"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما مشروبك غير الكحولي المفضل؟",
      "id": "td_ar_103"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما اللغة التي ترغب في تعلمها؟",
      "id": "td_ar_104"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما الشيء الذي جعلك تضحك مؤخرا؟",
      "id": "td_ar_105"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما المادة الدراسية التي كنت تحبها؟",
      "id": "td_ar_106"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "ما الحيوان المفضل لديك ولماذا؟",
      "id": "td_ar_107"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "كيف تحب ان تسترخي قبل النوم؟",
      "id": "td_ar_108"
    },
    {
      "type": "dare",
      "intensity": "spicy",
      "minAge": 18,
      "text": "قم بعمل 10 قفزات نجمة.",
