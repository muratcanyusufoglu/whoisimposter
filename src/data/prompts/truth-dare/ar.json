    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "قم بخمس قرفصاء.",
      "id": "td_ar_134"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "قل شكرا بثلاث لغات.",
      "id": "td_ar_135"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "قم بوضعية البلانك 5 ثوان.",
      "id": "td_ar_136"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "اصنع صوت باب يصر.",
      "id": "td_ar_137"
    },
    {
      "type": "dare",
      "intensity": "mild",
      "minAge": 4,
      "text": "قدم خدعة سحرية بسيطة او تظاهر بذلك.",
