{
  "gameId": "hot-takes",
  "locale": "ru",
  "version": 1,
  "prompts": [
    {
      "id": "ht_ru_001",
      "intensity": "mild",
      "minAge": 4,
      "text": "Чёрный чай лучше кофе."
    },
    {
      "id": "ht_ru_002",
      "intensity": "mild",
      "minAge": 4,
      "text": "Газированная вода на вкус как ошибка."
    },
    {
      "id": "ht_ru_003",
      "intensity": "mild",
      "minAge": 4,
      "text": "Бранч — это просто дорогой завтрак."
    },
    {
      "id": "ht_ru_004",
      "intensity": "mild",
      "minAge": 4,
      "text": "Смена обуви важнее стиля."
    },
    {
      "id": "ht_ru_005",
      "intensity": "mild",
      "minAge": 4,
      "text": "Сериал смотреть приятнее, чем фильм."
    },
    {
      "id": "ht_ru_006",
      "intensity": "mild",
      "minAge": 4,
      "text": "Место у прохода лучше окна."
    },
    {
      "id": "ht_ru_007",
      "intensity": "mild",
      "minAge": 4,
      "text": "Снимать концерт на телефон — пустая трата времени."
    },
    {
      "id": "ht_ru_008",
      "intensity": "mild",
      "minAge": 4,
      "text": "Пельмени спасают любой вечер."
    },
    {
      "id": "ht_ru_009",
      "intensity": "mild",
      "minAge": 4,
      "text": "Рынок лучше супермаркета."
    },
    {
      "id": "ht_ru_010",
      "intensity": "mild",
      "minAge": 4,
      "text": "Велосипед в городе удобнее машины."
    },
    {
      "id": "ht_ru_011",
      "intensity": "mild",
      "minAge": 4,
      "text": "Тишина — лучшая фоновая музыка."
    },
    {
      "id": "ht_ru_012",
      "intensity": "mild",
      "minAge": 4,
      "text": "Суп — это напиток."
    },
    {
      "id": "ht_ru_013",
      "intensity": "mild",
      "minAge": 4,
      "text": "Воскресенье должно быть длиннее."
    },
    {
      "id": "ht_ru_014",
      "intensity": "mild",
      "minAge": 4,
      "text": "Домашняя еда всегда лучше доставки."
    },
    {
      "id": "ht_ru_015",
      "intensity": "mild",
      "minAge": 4,
      "text": "Белые кроссовки идут ко всему."
    },
    {
      "id": "ht_ru_016",
      "intensity": "mild",
      "minAge": 4,
      "text": "Дождь делает город уютнее."
    },
    {
      "id": "ht_ru_017",
      "intensity": "mild",
      "minAge": 4,
      "text": "Чтение в телефоне не хуже книги."
    },
    {
      "id": "ht_ru_018",
      "intensity": "mild",
      "minAge": 4,
      "text": "Поздний ужин вкуснее раннего."
    },
    {
      "id": "ht_ru_019",
      "intensity": "mild",
      "minAge": 4,
      "text": "Каша — лучший завтрак."
    },
    {
      "id": "ht_ru_020",
      "intensity": "mild",
      "minAge": 4,
      "text": "Настоящий отдых — без плана."
    },
    {
      "id": "ht_ru_021",
      "intensity": "medium",
      "minAge": 13,
      "text": "Не отвечать сутки — это игнор."
    },
    {
      "id": "ht_ru_022",
      "intensity": "medium",
      "minAge": 13,
      "text": "Отменять планы в последний момент хуже опоздания."
    },
    {
      "id": "ht_ru_023",
      "intensity": "medium",
      "minAge": 13,
      "text": "Групповые поездки рушат дружбу."
    },
    {
      "id": "ht_ru_024",
      "intensity": "medium",
      "minAge": 13,
      "text": "Делиться геолокацией в отношениях нормально."
    },
    {
      "id": "ht_ru_025",
      "intensity": "medium",
      "minAge": 13,
      "text": "Кто говорит «без драм», тот и делает драмы."
    },
    {
      "id": "ht_ru_026",
      "intensity": "medium",
      "minAge": 13,
      "text": "Первое свидание должно быть коротким."
    },
    {
      "id": "ht_ru_027",
      "intensity": "medium",
      "minAge": 13,
      "text": "Человека видно по его заказу кофе."
    },
    {
      "id": "ht_ru_028",
      "intensity": "medium",
      "minAge": 13,
      "text": "Шумные рестораны — это провал."
    },
    {
      "id": "ht_ru_029",
      "intensity": "medium",
      "minAge": 13,
      "text": "Пунктуальность — это уважение."
    },
    {
      "id": "ht_ru_030",
      "intensity": "medium",
      "minAge": 13,
      "text": "Люди предпочитают быть правыми, а не счастливыми."
    },
    {
      "id": "ht_ru_031",
      "intensity": "medium",
      "minAge": 13,
      "text": "Друзья, которые исчезают при отношениях, эгоисты."
    },
    {
      "id": "ht_ru_032",
      "intensity": "medium",
      "minAge": 13,
      "text": "Постить сторис весь день — это показуха."
    },
    {
      "id": "ht_ru_033",
      "intensity": "medium",
      "minAge": 13,
      "text": "Самый тихий в компании — самый интересный."
    },
    {
      "id": "ht_ru_034",
      "intensity": "medium",
      "minAge": 13,
      "text": "Фраза «я занят» чаще всего отговорка."
    },
    {
      "id": "ht_ru_035",
      "intensity": "medium",
      "minAge": 13,
      "text": "Чаты — больше усталость, чем польза."
    },
    {
      "id": "ht_ru_036",
      "intensity": "medium",
      "minAge": 13,
      "text": "Ненавидеть смоллток — не значит быть глубоким."
    },
    {
      "id": "ht_ru_037",
      "intensity": "medium",
      "minAge": 13,
      "text": "Дружба видна по разделению счёта."
    },
    {
      "id": "ht_ru_038",
      "intensity": "medium",
      "minAge": 13,
      "text": "Планы и не прийти — это неуважение."
    },
    {
      "id": "ht_ru_039",
      "intensity": "medium",
      "minAge": 13,
      "text": "«Софт-лаунч» отношений — это неуверенность."
    },
    {
      "id": "ht_ru_040",
      "intensity": "medium",
      "minAge": 13,
      "text": "Жить без отпусков — плохое управление жизнью."
    },
    {
      "id": "ht_ru_041",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Большинство пар вместе по привычке."
    },
    {
      "id": "ht_ru_042",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Ревность — это эго, а не любовь."
    },
    {
      "id": "ht_ru_043",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Один раз проверил телефон — повторишь."
    },
    {
      "id": "ht_ru_044",
      "intensity": "spicy",
      "minAge": 18,
      "text": "«Пауза» — это медленный разрыв."
    },
    {
      "id": "ht_ru_045",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Этап переписки — это страх привязанности."
    },
    {
      "id": "ht_ru_046",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Измену прощают чаще, чем признают."
    },
    {
      "id": "ht_ru_047",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Самые уверенные выглядят сильными, но внутри хрупкие."
    },
    {
      "id": "ht_ru_048",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Ты не занят, ты не приоритет."
    },
    {
      "id": "ht_ru_049",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Многие влюблённости — это голод по вниманию."
    },
    {
      "id": "ht_ru_050",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Химия — это во многом правильный момент."
    },
    {
      "id": "ht_ru_051",
      "intensity": "mild",
      "minAge": 4,
      "text": "Холодная пицца вкуснее горячей."
    },
    {
      "id": "ht_ru_052",
      "intensity": "mild",
      "minAge": 4,
      "text": "Трейлеры портят фильмы."
    },
    {
      "id": "ht_ru_053",
      "intensity": "mild",
      "minAge": 4,
      "text": "Групповые чаты должны быть в муте по умолчанию."
    },
    {
      "id": "ht_ru_054",
      "intensity": "mild",
      "minAge": 4,
      "text": "Бранч — это просто повод переплачивать за яйца."
    },
    {
      "id": "ht_ru_055",
      "intensity": "mild",
      "minAge": 4,
      "text": "Носки с сандалиями — это нормально."
    },
    {
      "id": "ht_ru_056",
      "intensity": "mild",
      "minAge": 4,
      "text": "Дождливые дни расслабляют больше, чем солнечные."
    },
    {
      "id": "ht_ru_057",
      "intensity": "mild",
      "minAge": 4,
      "text": "Караоке веселее, когда поешь плохо."
    },
    {
      "id": "ht_ru_058",
      "intensity": "mild",
      "minAge": 4,
      "text": "Ложиться рано — недооцененная привычка."
    },
    {
      "id": "ht_ru_059",
      "intensity": "mild",
      "minAge": 4,
      "text": "В телефоне должен быть “не беспокоить” для отдельных людей."
    },
    {
      "id": "ht_ru_060",
      "intensity": "mild",
      "minAge": 4,
      "text": "Длинные голосовые — это невежливо."
    },
    {
      "id": "ht_ru_061",
      "intensity": "mild",
      "minAge": 4,
      "text": "Библиотеки — самые недооцененные места в городе."
    },
    {
      "id": "ht_ru_062",
      "intensity": "mild",
      "minAge": 4,
      "text": "Настолки лучше видеоигр для вечеринок."
    },
    {
      "id": "ht_ru_063",
      "intensity": "mild",
      "minAge": 4,
      "text": "Бумажные книги лучше электронных."
    },
    {
      "id": "ht_ru_064",
      "intensity": "mild",
      "minAge": 4,
      "text": "Лучшие места на концерте — сзади, где есть место танцевать."
    },
    {
      "id": "ht_ru_065",
      "intensity": "mild",
      "minAge": 4,
      "text": "Последний кусок не должен оставаться."
    },
    {
      "id": "ht_ru_066",
      "intensity": "mild",
      "minAge": 4,
      "text": "Уметь готовить полезнее, чем уметь водить."
    },
    {
      "id": "ht_ru_067",
      "intensity": "mild",
      "minAge": 4,
      "text": "Горы > пляж."
    },
    {
      "id": "ht_ru_068",
      "intensity": "mild",
      "minAge": 4,
      "text": "Маленькие свадьбы веселее больших."
    },
    {
      "id": "ht_ru_069",
      "intensity": "mild",
      "minAge": 4,
      "text": "Парам иногда нужно ездить в отпуск отдельно."
    },
    {
      "id": "ht_ru_070",
      "intensity": "mild",
      "minAge": 4,
      "text": "Тот, кто отменяет в последний момент, должен принести снеки в следующий раз."
    },
    {
      "id": "ht_ru_071",
      "intensity": "medium",
      "minAge": 13,
      "text": "Ночные перекусы лучше завтрака."
    },
    {
      "id": "ht_ru_072",
      "intensity": "medium",
      "minAge": 13,
      "text": "Лайки не должны быть публичными."
    },
    {
      "id": "ht_ru_073",
      "intensity": "medium",
      "minAge": 13,
      "text": "Разговаривать по громкой связи в публичном месте должно быть запрещено."
    },
    {
      "id": "ht_ru_074",
      "intensity": "medium",
      "minAge": 13,
      "text": "Мит-преп — переоценён."
    },
    {
      "id": "ht_ru_075",
      "intensity": "medium",
      "minAge": 13,
      "text": "Лучшие фото — спонтанные."
    },
    {
      "id": "ht_ru_076",
      "intensity": "medium",
      "minAge": 13,
      "text": "Дорогие кроссовки — пустая трата денег."
    },
    {
      "id": "ht_ru_077",
      "intensity": "medium",
      "minAge": 13,
      "text": "Выходные должны быть трёхдневными."
    },
    {
      "id": "ht_ru_078",
      "intensity": "medium",
      "minAge": 13,
      "text": "Неожиданные визиты — это невежливо."
    },
    {
      "id": "ht_ru_079",
      "intensity": "medium",
      "minAge": 13,
      "text": "Ананасовый сок подходит к любому смузи."
    },
    {
      "id": "ht_ru_080",
      "intensity": "medium",
      "minAge": 13,
      "text": "Писать от руки лучше, чем печатать."
    },
    {
      "id": "ht_ru_081",
      "intensity": "medium",
      "minAge": 13,
      "text": "Онлайн-дейтинг сделал людей более придирчивыми."
    },
    {
      "id": "ht_ru_082",
      "intensity": "medium",
      "minAge": 13,
      "text": "Жить одному делает креативнее."
    },
    {
      "id": "ht_ru_083",
      "intensity": "medium",
      "minAge": 13,
      "text": "«Hot take» чаще всего просто здравый смысл."
    },
    {
      "id": "ht_ru_084",
      "intensity": "medium",
      "minAge": 13,
      "text": "С собой всегда стоит брать многоразовую чашку."
    },
    {
      "id": "ht_ru_085",
      "intensity": "medium",
      "minAge": 13,
      "text": "Уличная еда лучше ресторанной."
    },
    {
      "id": "ht_ru_086",
      "intensity": "medium",
      "minAge": 13,
      "text": "«Прочитано» создаёт больше драмы, чем решает."
    },
    {
      "id": "ht_ru_087",
      "intensity": "medium",
      "minAge": 13,
      "text": "Общий плейлист — тест для отношений."
    },
    {
      "id": "ht_ru_088",
      "intensity": "medium",
      "minAge": 13,
      "text": "Отдельные одеяла полезнее для пары."
    },
    {
      "id": "ht_ru_089",
      "intensity": "medium",
      "minAge": 13,
      "text": "Лучшее в путешествии — планирование."
    },
    {
      "id": "ht_ru_090",
      "intensity": "medium",
      "minAge": 13,
      "text": "Наушники в зале — обязательно."
    },
    {
      "id": "ht_ru_091",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Бариста заслуживают больше чаевых."
    },
    {
      "id": "ht_ru_092",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Татуировки должны быть разрешены на любой работе."
    },
    {
      "id": "ht_ru_093",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Нам нужно меньше уведомлений, а не больше."
    },
    {
      "id": "ht_ru_094",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Питомцев стоит пускать в большее число кафе."
    },
    {
      "id": "ht_ru_095",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Праздники должны выбирать голосованием."
    },
    {
      "id": "ht_ru_096",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Всем стоит уметь оказывать первую помощь."
    },
    {
      "id": "ht_ru_097",
      "intensity": "spicy",
      "minAge": 18,
      "text": "В дорогих ресторанах должно быть детское меню."
    },
    {
      "id": "ht_ru_098",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Кинотеатрам стоит вернуть антракты."
    },
    {
      "id": "ht_ru_099",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Отчёты о прочтении должны быть опциональными везде."
    },
    {
      "id": "ht_ru_100",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Опоздание — это выбор, а не характер."
    },
    {
      "id": "ht_ru_101",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Большинство людей соглашаются на меньшее, потому что устали от свиданий."
    },
    {
      "id": "ht_ru_102",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Ревность — это форма эго, а не любви."
    },
    {
      "id": "ht_ru_103",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Если один раз подглядел, сделаешь это снова."
    },
    {
      "id": "ht_ru_104",
      "intensity": "spicy",
      "minAge": 18,
      "text": "'Стадия переписки' — это просто страх обязательств."
    },
    {
      "id": "ht_ru_105",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Люди прощают измену больше, чем признают."
    },
    {
      "id": "ht_ru_106",
      "intensity": "spicy",
      "minAge": 18,
      "text": "'Пауза' в отношениях — это просто медленный разрыв."
    },
    {
      "id": "ht_ru_107",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Самые уверенные люди часто самые хрупкие."
    },
    {
      "id": "ht_ru_108",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Ты не 'слишком занят' — тебе просто неинтересно."
    },
    {
      "id": "ht_ru_109",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Большинство влюблённостей — про внимание, а не про притяжение."
    },
    {
      "id": "ht_ru_110",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Романтическая химия — это в основном удачное время."
    },
    {
      "id": "ht_ru_111",
      "intensity": "mild",
      "minAge": 4,
      "text": "Лёд в газировке портит напиток."
    },
    {
      "id": "ht_ru_112",
      "intensity": "mild",
      "minAge": 4,
      "text": "Места у окна в самолёте переоценены."
    },
    {
      "id": "ht_ru_113",
      "intensity": "mild",
      "minAge": 4,
      "text": "Спонтанные фото лучше постановочных."
    },
    {
      "id": "ht_ru_114",
      "intensity": "mild",
      "minAge": 4,
      "text": "На приглашения нужно отвечать цифрами, а не 'может быть'."
    },
    {
      "id": "ht_ru_115",
      "intensity": "mild",
      "minAge": 4,
      "text": "Менеджеры паролей должны быть стандартом на каждом телефоне."
    },
    {
      "id": "ht_ru_116",
      "intensity": "mild",
      "minAge": 4,
      "text": "Душ вечером лучше, чем утром."
    },
    {
      "id": "ht_ru_117",
      "intensity": "mild",
      "minAge": 4,
      "text": "Каждый день постить еду в сторис — это слишком."
    },
    {
      "id": "ht_ru_118",
      "intensity": "mild",
      "minAge": 4,
      "text": "Ремейки фильмов должны оправдывать своё существование."
    },
    {
      "id": "ht_ru_119",
      "intensity": "mild",
      "minAge": 4,
      "text": "Кнопка 'пропустить заставку' — лучшее изобретение."
    },
    {
      "id": "ht_ru_120",
      "intensity": "mild",
      "minAge": 4,
      "text": "Cold brew — это просто кофе, который забыл быть горячим."
    },
    {
      "id": "ht_ru_121",
      "intensity": "mild",
      "minAge": 4,
      "text": "Программы лояльности обычно того не стоят."
    },
    {
      "id": "ht_ru_122",
      "intensity": "mild",
      "minAge": 4,
      "text": "Фоновая музыка в кафе слишком громкая."
    },
    {
      "id": "ht_ru_123",
      "intensity": "mild",
      "minAge": 4,
      "text": "Двухфакторная аутентификация должна быть обязательной."
    },
    {
      "id": "ht_ru_124",
      "intensity": "mild",
      "minAge": 4,
      "text": "Новые камеры телефонов в последнее время не так уж улучшились."
    },
    {
      "id": "ht_ru_125",
      "intensity": "mild",
      "minAge": 4,
      "text": "'Нетребовательный' — это не черта личности."
    },
    {
      "id": "ht_ru_126",
      "intensity": "mild",
      "minAge": 4,
      "text": "Большинство подписок должны включать бесплатную неделю."
    },
    {
      "id": "ht_ru_127",
      "intensity": "mild",
      "minAge": 4,
      "text": "Когда остаёшься с ночёвкой, нужно приносить небольшой подарок."
    },
    {
      "id": "ht_ru_128",
      "intensity": "mild",
      "minAge": 4,
      "text": "Лучший способ путешествовать — без плотного расписания."
    },
    {
      "id": "ht_ru_129",
      "intensity": "mild",
      "minAge": 4,
      "text": "Наряжаться в театр должно снова войти в моду."
    },
    {
      "id": "ht_ru_130",
      "intensity": "mild",
      "minAge": 4,
      "text": "Десерт надо заказывать первым."
    },
    {
      "id": "ht_ru_131",
      "intensity": "medium",
      "minAge": 13,
      "text": "Выйти из группового чата честнее, чем пропадать."
    },
    {
      "id": "ht_ru_132",
      "intensity": "medium",
      "minAge": 13,
      "text": "Офисный смолток утомляет больше, чем работа."
    },
    {
      "id": "ht_ru_133",
      "intensity": "medium",
      "minAge": 13,
      "text": "У встреч всегда должно быть время окончания."
    },
    {
      "id": "ht_ru_134",
      "intensity": "medium",
      "minAge": 13,
      "text": "Звуки дождя лучше белого шума."
    },
    {
      "id": "ht_ru_135",
      "intensity": "medium",
      "minAge": 13,
      "text": "Эмодзи в рабочих письмах — это нормально."
    },
    {
      "id": "ht_ru_136",
      "intensity": "medium",
      "minAge": 13,
      "text": "Слово 'иконичный' используют слишком часто."
    },
    {
      "id": "ht_ru_137",
      "intensity": "medium",
      "minAge": 13,
      "text": "Беспорядочный стол не означает, что ты креативный."
    },
    {
      "id": "ht_ru_138",
      "intensity": "medium",
      "minAge": 13,
      "text": "Сохранять каждое фото — это цифровое накопительство."
    },
    {
      "id": "ht_ru_139",
      "intensity": "medium",
      "minAge": 13,
      "text": "Пора перестать отвечать 'К'."
    },
    {
      "id": "ht_ru_140",
      "intensity": "medium",
      "minAge": 13,
      "text": "Аплодисменты в самолёте не нужны."
    },
    {
      "id": "ht_ru_141",
      "intensity": "medium",
      "minAge": 13,
      "text": "Политики возврата должны быть дольше 14 дней."
    },
    {
      "id": "ht_ru_142",
      "intensity": "medium",
      "minAge": 13,
      "text": "Одинаковые образы — это мило, а не кринж."
    },
    {
      "id": "ht_ru_143",
      "intensity": "medium",
      "minAge": 13,
      "text": "Взрослые тоже могут любить мультфильмы."
    },
    {
      "id": "ht_ru_144",
      "intensity": "medium",
      "minAge": 13,
      "text": "Кнопку 'принять все cookies' надо запретить."
    },
    {
      "id": "ht_ru_145",
      "intensity": "medium",
      "minAge": 13,
      "text": "Лишние подушки на кровати бессмысленны."
    },
    {
      "id": "ht_ru_146",
      "intensity": "medium",
      "minAge": 13,
      "text": "Фрукты должны быть в салатах."
    },
    {
      "id": "ht_ru_147",
      "intensity": "medium",
      "minAge": 13,
      "text": "Купить планер не значит, что ты им воспользуешься."
    },
    {
      "id": "ht_ru_148",
      "intensity": "medium",
      "minAge": 13,
      "text": "'Баланс работа‑жизнь' должен быть реальной метрикой."
    },
    {
      "id": "ht_ru_149",
      "intensity": "medium",
      "minAge": 13,
      "text": "Крошечные дома непрактичны."
    },
    {
      "id": "ht_ru_150",
      "intensity": "medium",
      "minAge": 13,
      "text": "Общественным скамейкам нужно больше тени."
    },
    {
      "id": "ht_ru_151",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Говорить по телефону без наушников — неуважение."
    },
    {
      "id": "ht_ru_152",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Чистый инбокс переоценён."
    },
    {
      "id": "ht_ru_153",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Лучший дневной сон — 20 минут или меньше."
    },
    {
      "id": "ht_ru_154",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Пересматривать сериал расслабляет больше, чем начинать новый."
    },
    {
      "id": "ht_ru_155",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Подписи в письмах слишком длинные."
    },
    {
      "id": "ht_ru_156",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Большинство 'лимитированных' дропов — это фальшивая срочность."
    },
    {
      "id": "ht_ru_157",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Бесплатная доставка должна быть стандартом."
    },
    {
      "id": "ht_ru_158",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Нужно нормализовать фразу 'мне нужен выходной'."
    },
    {
      "id": "ht_ru_159",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Индикатор 'печатает…' вызывает тревогу."
    },
    {
      "id": "ht_ru_160",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Опен‑спейсы — плохой дизайн."
    },
    {
      "id": "ht_ru_161",
      "intensity": "mild",
      "minAge": 4,
      "text": "Холодная пицца лучше горячей."
    },
    {
      "id": "ht_ru_162",
      "intensity": "mild",
      "minAge": 4,
      "text": "Постеры фильмов интереснее трейлеров."
    },
    {
      "id": "ht_ru_163",
      "intensity": "mild",
      "minAge": 4,
      "text": "Групповые чаты должны быть в беззвучном режиме по умолчанию."
    },
    {
      "id": "ht_ru_164",
      "intensity": "mild",
      "minAge": 4,
      "text": "Бранч — это просто повод переплатить за яйца."
    },
    {
      "id": "ht_ru_165",
      "intensity": "mild",
      "minAge": 4,
      "text": "Корочка пиццы — лучшая часть."
    },
    {
      "id": "ht_ru_166",
      "intensity": "mild",
      "minAge": 4,
      "text": "Пасмурные дни уютнее яркого солнца."
    },
    {
      "id": "ht_ru_167",
      "intensity": "mild",
      "minAge": 4,
      "text": "Караоке веселее, когда поёшь плохо."
    },
    {
      "id": "ht_ru_168",
      "intensity": "mild",
      "minAge": 4,
      "text": "Ложиться спать рано недооценено."
    },
    {
      "id": "ht_ru_169",
      "intensity": "mild",
      "minAge": 4,
      "text": "В телефоне должен быть 'не беспокоить' для отдельных людей."
    },
    {
      "id": "ht_ru_170",
      "intensity": "mild",
      "minAge": 4,
      "text": "Длинные голосовые — это грубо."
    },
    {
      "id": "ht_ru_171",
      "intensity": "mild",
      "minAge": 4,
      "text": "Библиотеки — самые недооценённые места в городе."
    },
    {
      "id": "ht_ru_172",
      "intensity": "mild",
      "minAge": 4,
      "text": "Карточные игры лучше настолок на вечеринках."
    },
    {
      "id": "ht_ru_173",
      "intensity": "mild",
      "minAge": 4,
      "text": "Бумажные книги лучше ридеров."
    },
    {
      "id": "ht_ru_174",
      "intensity": "mild",
      "minAge": 4,
      "text": "Камерные концерты лучше стадионных."
    },
    {
      "id": "ht_ru_175",
      "intensity": "mild",
      "minAge": 4,
      "text": "Последний кусок никогда не должен оставаться."
    },
    {
      "id": "ht_ru_176",
      "intensity": "mild",
      "minAge": 4,
      "text": "Учиться готовить полезнее, чем учиться водить."
    },
    {
      "id": "ht_ru_177",
      "intensity": "mild",
      "minAge": 4,
      "text": "Горы > пляжи."
    },
    {
      "id": "ht_ru_178",
      "intensity": "mild",
      "minAge": 4,
      "text": "Домашние вечеринки веселее банкетных залов."
    },
    {
      "id": "ht_ru_179",
      "intensity": "mild",
      "minAge": 4,
      "text": "Парам иногда стоит отдыхать отдельно."
    },
    {
      "id": "ht_ru_180",
      "intensity": "mild",
      "minAge": 4,
      "text": "Друзья, которые отменяют в последний момент, должны принести закуски в следующий раз."
    },
    {
      "id": "ht_ru_181",
      "intensity": "medium",
      "minAge": 13,
      "text": "Поздний ужин лучше раннего."
    },
    {
      "id": "ht_ru_182",
      "intensity": "medium",
      "minAge": 13,
      "text": "'Лайки' в соцсетях не должны быть публичными."
    },
    {
      "id": "ht_ru_183",
      "intensity": "medium",
      "minAge": 13,
      "text": "Громкая связь в общественных местах должна быть запрещена."
    },
    {
      "id": "ht_ru_184",
      "intensity": "medium",
      "minAge": 13,
      "text": "Meal prep переоценён."
    },
    {
      "id": "ht_ru_185",
      "intensity": "medium",
      "minAge": 13,
      "text": "Фото без фильтров выглядят честнее."
    },
    {
      "id": "ht_ru_186",
      "intensity": "medium",
      "minAge": 13,
      "text": "Брендовые вещи редко стоят своей цены."
    },
    {
      "id": "ht_ru_187",
      "intensity": "medium",
      "minAge": 13,
      "text": "Воскресенье должно делать уик‑енд трёхдневным."
    },
    {
      "id": "ht_ru_188",
      "intensity": "medium",
      "minAge": 13,
      "text": "Визиты без предупреждения — неуважение."
    },
    {
      "id": "ht_ru_189",
      "intensity": "medium",
      "minAge": 13,
      "text": "Ананасовый сок должен быть в каждом смузи."
    },
    {
      "id": "ht_ru_190",
      "intensity": "medium",
      "minAge": 13,
      "text": "Записи от руки лучше, чем печатать."
    },
    {
      "id": "ht_ru_191",
      "intensity": "medium",
      "minAge": 13,
      "text": "Онлайн‑дейтинг сделал людей более придирчивыми."
    },
    {
      "id": "ht_ru_192",
      "intensity": "medium",
      "minAge": 13,
      "text": "Жизнь в одиночку делает людей креативнее."
    },
    {
      "id": "ht_ru_193",
      "intensity": "medium",
      "minAge": 13,
      "text": "'Hot takes' — обычно просто здравый смысл."
    },
    {
      "id": "ht_ru_194",
      "intensity": "medium",
      "minAge": 13,
      "text": "Всегда нужно приносить свою многоразовую кружку."
    },
    {
      "id": "ht_ru_195",
      "intensity": "medium",
      "minAge": 13,
      "text": "Короткое меню — признак хорошей кухни."
    },
    {
      "id": "ht_ru_196",
      "intensity": "medium",
      "minAge": 13,
      "text": "Отметки 'прочитано' создают больше драмы, чем решают."
    },
    {
      "id": "ht_ru_197",
      "intensity": "medium",
      "minAge": 13,
      "text": "Общий плейлист — это тест отношений."
    },
    {
      "id": "ht_ru_198",
      "intensity": "medium",
      "minAge": 13,
      "text": "Раздельные одеяла полезнее для пар."
    },
    {
      "id": "ht_ru_199",
      "intensity": "medium",
      "minAge": 13,
      "text": "Лучшая часть поездки — её планирование."
    },
    {
      "id": "ht_ru_200",
      "intensity": "medium",
      "minAge": 13,
      "text": "В спортзале наушники обязательны."
    },
    {
      "id": "ht_ru_201",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Баристам стоит оставлять больше чаевых."
    },
    {
      "id": "ht_ru_202",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Татуировки должны быть разрешены на всех работах."
    },
    {
      "id": "ht_ru_203",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Людям нужно меньше уведомлений, а не больше."
    },
    {
      "id": "ht_ru_204",
      "intensity": "spicy",
      "minAge": 18,
      "text": "В большем числе кафе должны пускать с питомцами."
    },
    {
      "id": "ht_ru_205",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Праздники должны выбирать народным голосованием."
    },
    {
      "id": "ht_ru_206",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Всем нужно выучить основы первой помощи."
    },
    {
      "id": "ht_ru_207",
      "intensity": "spicy",
      "minAge": 18,
      "text": "В дорогих ресторанах не место детям."
    },
    {
      "id": "ht_ru_208",
      "intensity": "spicy",
      "minAge": 18,
      "text": "В кинотеатрах должны вернуть антракт."
    },
    {
      "id": "ht_ru_209",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Отчёты о прочтении должны быть опцией в каждом приложении."
    },
    {
      "id": "ht_ru_210",
      "intensity": "spicy",
      "minAge": 18,
      "text": "Гостинг хуже честного отказа."
    }
  ]
}
